{
  "name": "rag-course-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:mock:webpack": "node scripts/dev-mock.mjs --webpack",
    "build": "npm run check:boundaries && next build && npm run check:release",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-timeout=10000 tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "15.5.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "4.20.6",
    "typescript": "~5.9.3"
  }
}
