# Live is the default. npm run dev:mock is the only preview entry point.
NEXT_PUBLIC_DATA_MODE=live
# Server-only upstream. Browser always calls same-origin /api/v1.
CORE_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Add your web origin to Core CORS_ORIGINS. Cookie Secure must match HTTPS usage.
# No API/service key belongs in NEXT_PUBLIC_* variables.
