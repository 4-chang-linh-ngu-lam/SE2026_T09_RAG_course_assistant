{
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "needs_changes", "blocked", "audit_only"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "path": { "type": "string" },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "proposed_fix": { "type": "string" }
        },
        "required": ["severity", "path", "issue", "evidence", "proposed_fix"]
      }
    },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "findings", "next_actions", "blockers"]
}
