POSTGRES_DB=rag_course
POSTGRES_USER=rag_course
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://rag_course:change-me-local-only@db:5432/rag_course
# Web server proxies /api/v1 to Core; Compose uses http://core:8000.
CORE_API_URL=http://localhost:8000
# Canonical browser origin; Core also uses it for staff invitation/reset links.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=live
POSTGRES_PORT=5432
CORE_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

# Local Compose example only. Replace DB credentials and URL together; URL-encode special characters.
# Provide distinct random secrets (at least 32 characters) to enable authentication/internal access.
# SECRET_KEY=
# INTERNAL_SERVICE_SECRET=
# Distinct random Web attestation key, same value in apps/web/.env.local (32+ chars).
# CORE_PROXY_SECRET=

# Optional Document profile: separate random database credential and service keys.
# Existing local Core: services/document/scripts/configure-local.ps1
# DOCUMENT_DATABASE_URL=postgresql+psycopg://lumi_document:REPLACE_WITH_RANDOM_PASSWORD@db:5432/rag_course
# DOCUMENT_EVENTS_SERVICE_SECRET=
# DOCUMENT_INTERNAL_SERVICE_SECRET=
# DOCUMENT_EVENT_READER_SECRET=
DOCUMENT_PORT=8200

STUDENT_ACTIVATION_EXPIRE_HOURS=24
# SMTP is optional for health/Student activation, required for staff forgot email delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=10
