POSTGRES_DB=rag_course
POSTGRES_USER=rag_course
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://rag_course:change-me-local-only@db:5432/rag_course
NEXT_PUBLIC_CORE_API_URL=http://localhost:8000
POSTGRES_PORT=5432
CORE_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=3

# Local Compose Document profile only: separate login/database on the shared Postgres instance.
# These placeholders are for local development and must not be reused in deployed environments.
# If changing Document credentials, update DOCUMENT_DATABASE_URL too and URL-encode special characters.
# Compose derives DOCUMENT_DATABASE_ADMIN_URL from POSTGRES_USER/PASSWORD unless explicitly overridden.
DOCUMENT_DATABASE_NAME=lumi_document
DOCUMENT_DATABASE_USER=lumi_document
DOCUMENT_DATABASE_PASSWORD=change-me-document-local-only
DOCUMENT_DATABASE_URL=postgresql+psycopg://lumi_document:change-me-document-local-only@db:5432/lumi_document
DOCUMENT_STORAGE_ROOT=/var/lib/lumi-document/files

# Local Compose example only. Replace DB credentials and URL together; URL-encode special characters.
# Provide distinct random secrets (at least 32 characters) to enable authentication/internal access.
# SECRET_KEY=
# INTERNAL_SERVICE_SECRET=  # Legacy X-Service-Key; retained only for the legacy GET route during migration.

# SYS-02 Service JWT placeholders. Leave unset until per-service keys/trust entries are provisioned.
# Never put private key material in this file or in Git.
# SERVICE_JWT_IDENTITY=
# SERVICE_JWT_ISSUER=
# SERVICE_JWT_KEY_ID=
# SERVICE_JWT_PRIVATE_KEY_FILE=/run/secrets/<service>-service-jwt-private.pem
# SERVICE_JWT_TRUSTED_KEYS_JSON={}
# Trust-map example only: {"document-key-1":{"issuer":"urn:lumi:service:document","subject":"document","public_key_file":"/run/secrets/document-public.pem","audiences":["core"],"scopes":["core:check_access"]}}
# SERVICE_JWT_EXPECTED_AUDIENCE=core
# SERVICE_JWT_ISSUED_AUDIENCES=[]
# SERVICE_JWT_ISSUED_SCOPES=[]
# SERVICE_JWT_TTL_SECONDS=300
# SERVICE_JWT_CLOCK_SKEW_SECONDS=30

STUDENT_ACTIVATION_EXPIRE_HOURS=24
# SMTP and PUBLIC_WEB_URL are needed for staff invitation/recovery links. Student codes are
# handed to Admin directly; the Core worker does not email Student activation/reset codes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=10
