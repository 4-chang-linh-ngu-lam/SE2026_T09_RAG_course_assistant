POSTGRES_DB=rag_course
POSTGRES_USER=rag_course
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://rag_course:change-me-local-only@db:5432/rag_course
NEXT_PUBLIC_CORE_API_URL=http://localhost:8000
POSTGRES_PORT=5432
CORE_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=3

# Local Compose example only. Replace DB credentials and URL together; URL-encode special characters.
# Provide distinct random secrets (at least 32 characters) to enable authentication/internal access.
# SECRET_KEY=
# INTERNAL_SERVICE_SECRET=

STUDENT_ACTIVATION_EXPIRE_HOURS=24
# SMTP and PUBLIC_WEB_URL are needed for staff invitation/recovery links. Student codes are
# handed to Admin directly; the Core worker does not email Student activation/reset codes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=10
