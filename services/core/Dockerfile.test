ARG CORE_TEST_BASE=rag-course-core:local
FROM ${CORE_TEST_BASE}
ENV COVERAGE_FILE=/tmp/.coverage
USER root
RUN pip install --no-cache-dir 'pytest>=8,<10' 'pytest-cov>=6,<8' 'httpx>=0.27,<1' 'httpx2>=2,<3'
COPY pyproject.toml ./
COPY tests ./tests
USER core
CMD ["pytest", "-q", "-p", "no:cacheprovider"]
