FROM python:3.12-slim-bookworm AS base
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 libgl1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /runtime
ENV OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false HF_HUB_DISABLE_XET=1

FROM base AS marker
RUN python -m pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install --no-cache-dir marker-pdf==2.2.0 torch==2.10.0 torchvision==0.25.0
ENV TORCH_DEVICE=cpu
COPY idp/ocr/backends/model_worker.py ./model_worker.py
ENTRYPOINT ["python", "/runtime/model_worker.py"]

FROM base AS paddle
RUN python -m pip install --no-cache-dir paddlepaddle==3.3.1 "paddleocr[doc-parser]==3.7.0" paddlex==3.7.2
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
COPY idp/ocr/backends/model_worker.py ./model_worker.py
ENTRYPOINT ["python", "/runtime/model_worker.py"]


# GPU variant (CUDA 12.6 wheels; needs `docker run --gpus all` and a driver >= 560).
# Same worker and model cache layout as the CPU stage; selected with device="gpu".
FROM base AS paddle-gpu
RUN python -m pip install --no-cache-dir paddlepaddle-gpu==3.3.1 --index-url https://www.paddlepaddle.org.cn/packages/stable/cu126/ --extra-index-url https://pypi.org/simple
RUN python -m pip install --no-cache-dir "paddleocr[doc-parser]==3.7.0" paddlex==3.7.2
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
COPY idp/ocr/backends/model_worker.py ./model_worker.py
ENTRYPOINT ["python", "/runtime/model_worker.py"]

# The CUDA libraries already come from Paddle's cu126 installation.
FROM paddle-gpu AS scan-gpu
RUN python -m pip install --no-cache-dir --no-deps torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu126
RUN python -m pip install --no-cache-dir --no-deps easyocr==1.7.2 ultralytics==8.4.215 \
    sympy mpmath matplotlib contourpy cycler fonttools kiwisolver pyparsing \
    python-dateutil polars polars-runtime-32 ultralytics-thop scikit-image scipy \
    ninja imageio tifffile lazy-loader python-bidi
