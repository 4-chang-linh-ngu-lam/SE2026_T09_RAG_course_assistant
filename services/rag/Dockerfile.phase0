FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie \
    fonts-dejavu-core libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements-phase0.lock.txt ./
RUN python -m pip install --no-cache-dir -r requirements-phase0.lock.txt
COPY idp ./idp
COPY parser ./parser
COPY chunking ./chunking
COPY search ./search
COPY retrieval ./retrieval
COPY tests ./tests
COPY tools ./tools
COPY pytest.ini ./
ENV PYTHONPATH=/work
CMD ["python", "-m", "pytest", "tests", "-q"]
